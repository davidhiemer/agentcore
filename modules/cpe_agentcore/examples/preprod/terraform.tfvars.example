# ==============================================================================
# PREPROD ENVIRONMENT CONFIGURATION
# Amazon Bedrock AgentCore Platform
# ==============================================================================

environment    = "preprod"
aws_region     = "us-east-1"
aws_account_id = "222222222222"

# ==============================================================================
# VPC CONFIGURATION
# VPC is created externally; subnets, route tables, security groups, and NAT
# gateways are created by this module within the provided VPC
# ==============================================================================
vpc_config = {
  # Existing VPC ID
  vpc_id = "vpc-preprod12345"

  # VPC CIDR block - used for subnet calculations
  vpc_cidr = "10.1.0.0/16"

  # Availability zones to deploy across (2-3 AZs)
  availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]

  # Optional: existing Internet Gateway ID (if VPC already has one)
  # Set to null to have the module create a new IGW
  internet_gateway_id = "igw-preprod12345"
}

# ==============================================================================
# SCALE PROFILE - Preprod (Production-like)
# ==============================================================================
scale_profile = {
  # Network - production-like HA configuration
  nat_mode              = "per_az"  # Must match prod
  vpc_endpoint_az_count = 2

  # Runtime - production-like capacity, slightly lower limits
  runtime_concurrency_limit       = 100
  runtime_memory_mb_default       = 2048
  runtime_timeout_seconds_default = 300

  # Memory - production-like retention
  memory_session_ttl_hours        = 48
  memory_long_term_retention_days = 90

  # Gateway - production-like limits
  gateway_rate_limit_default  = 5000
  gateway_burst_limit_default = 500

  # Tools - production-like resources
  code_interpreter_max_execution_seconds = 60
  code_interpreter_memory_mb             = 512
  browser_max_page_size_mb               = 25

  # Observability - production-like retention
  log_retention_days         = 180
  metrics_resolution_seconds = 60
  alarm_evaluation_periods   = 3
  xray_sampling_rate         = 0.05

  # Feature flags - match production (conservative)
  enable_memory   = true
  enable_identity = true
  enable_gateway  = true
  enable_tools    = false  # Disabled until prod-ready
}

# ==============================================================================
# AGENT DEFINITIONS
# ==============================================================================
agents = {
  "customer-support" = {
    name        = "Customer Support Agent"
    description = "Handles customer inquiries and support requests"

    container_image_digest = "sha256:a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456"

    mode = "realtime"

    capability_bundles = [
      "baseline",
      "dynamodb_readonly",
      "bedrock_invoke_model",
      "agentcore_memory",
      "agentcore_gateway"
    ]

    memory_enabled  = true
    gateway_enabled = true
    tools_enabled   = false

    additional_tags = {
      Team = "customer-experience"
    }
  }

  "data-analyst" = {
    name        = "Data Analyst Agent"
    description = "Analyzes data and generates reports"

    container_image_digest = "sha256:b2c3d4e5f67890123456789012345678901abcdef1234567890abcdef1234567"

    mode            = "async"
    timeout_seconds = 7200  # 2 hours
    memory_mb       = 2048

    capability_bundles = [
      "baseline",
      "s3_readwrite",
      "dynamodb_readonly",
      "bedrock_invoke_model",
      "agentcore_memory"
    ]

    memory_enabled  = true
    gateway_enabled = true
    tools_enabled   = false

    additional_tags = {
      Team = "data-engineering"
    }
  }
}

# ==============================================================================
# MEMORY CONFIGURATION
# ==============================================================================
memory_config = {
  session_memory = {
    enabled            = true
    max_context_tokens = 100000
  }

  long_term_memory = {
    enabled            = true
    encryption_key_arn = "arn:aws:kms:us-east-1:222222222222:key/preprod-memory-key"
  }
}

# ==============================================================================
# IDENTITY CONFIGURATION (Cognito for preprod testing)
# ==============================================================================
identity_config = {
  enabled = true

  provider = {
    type = "cognito"
  }

  role_mappings = {
    "support-team" = {
      claim_name  = "cognito:groups"
      claim_value = "SupportTeam"
      agent_keys  = ["customer-support"]
    }
    "data-team" = {
      claim_name  = "cognito:groups"
      claim_value = "DataTeam"
      agent_keys  = ["data-analyst"]
    }
  }
}

# ==============================================================================
# GATEWAY CONFIGURATION
# ==============================================================================
gateway_config = {
  tool_policies = {
    "weather-api" = {
      tool_name      = "get_weather"
      allowed_agents = ["customer-support"]
      rate_limit = {
        requests_per_minute = 500
        burst_limit         = 100
      }
      timeout_seconds = 15
    }
    "search-api" = {
      tool_name      = "search_documents"
      allowed_agents = ["data-analyst", "customer-support"]
      rate_limit = {
        requests_per_minute = 1000
        burst_limit         = 200
      }
      timeout_seconds = 30
    }
  }

  connections = {
    "external-weather" = {
      name         = "External Weather API"
      endpoint_url = "https://api.weather.example.com"
      auth_type    = "api_key"
    }
    "internal-search" = {
      name         = "Internal Search Service"
      endpoint_url = "https://search.internal.example.com"
      auth_type    = "iam"
    }
  }
}

# ==============================================================================
# TOOLS CONFIGURATION (Disabled for preprod)
# ==============================================================================
tools_config = {
  code_interpreter = {
    enabled       = false
    languages     = ["python"]
    allow_network = false
  }

  browser_tool = {
    enabled            = false
    allowed_domains    = []
    blocked_domains    = []
    screenshot_enabled = false
  }
}

# ==============================================================================
# CROSS-ACCOUNT ACCESS (Enabled for testing)
# ==============================================================================
cross_account_access = {
  enabled = true
  allowed_caller_accounts = [
    "444444444444" # Test application account
  ]
  allowed_caller_roles = {
    "444444444444" = [
      "arn:aws:iam::444444444444:role/test-app-role"
    ]
  }
  allowed_caller_vpc_ids = [
    "vpc-caller-test"
  ]
}

# ==============================================================================
# OBSERVABILITY
# ==============================================================================
observability_config = {
  splunk_hec_endpoint         = "https://splunk-hec.bank.internal:8088"
  splunk_hec_token_secret_arn = "arn:aws:secretsmanager:us-east-1:222222222222:secret:agentcore/splunk-hec-token"
  alarm_sns_topic_arn         = "arn:aws:sns:us-east-1:222222222222:agentcore-preprod-alarms"
  enable_xray_tracing         = true
  dashboard_enabled           = true
}

# ==============================================================================
# TAGS
# ==============================================================================
tags = {
  CostCenter  = "platform-engineering"
  Application = "agentcore"
  Owner       = "platform-team"
}
